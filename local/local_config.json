            "%d %B %Y",
            "%d %b %Y",
            "%Y-%m-%d",
            "%d/%m/%Y",
            "%m/%d/%Y",
            "%d-%m-%Y"
          ],
          "nearby_line_window": 2,
          "details_block": {
            "enabled": true,
            "header": "Details",
