          "sanitize": true,
          "fallback": "unknown"
        },
        "date": {
          "sanitize": false,
          "fallback": "unknown-date"
        },
        "total": {
          "sanitize": false,
          "fallback": "unknown"
        },
        "currency": {
          "sanitize": false,
          "fallback": "unknown"
        }
      },
      "manual_review_for_missing": [
        "account",
        "date"
      ],
      "report_columns": {
        "account": "Client Ref.",
        "date": "PDF Invoice Date",
        "number": "PDF Invoice No.",
        "currency": "Topped Currency",
        "total": "Topped amount"
      }
    }
  },
  "rclone": {
    "enabled": true,
    "remote": "mydrive-service",
    "source_drive_folder": "003 Finance Operations/001 Invoices/001 Google Ads/000 Input Folder",
    "destination_drive_folder": "003 Finance Operations/001 Invoices/001 Google Ads",
    "destination_subfolder_template": "{year}{month}",
    "archive_drive_folder": null
  },
  "reports": {
    "enabled": true,
    "filename_template": "parsed_fields_{timestamp}.csv"
  },
  "google_sheets": {
    "enabled": true,
    "spreadsheet_url": "https://docs.google.com/spreadsheets/d/1RnghBiJRAUZAC0SrQ3r5J02hjaJI2NzhIEcyi_RKgas/edit?gid=644784821#gid=644784821",
    "service_account_file": "keys/connect-ai-pc-fad7ca673e19.json",
    "tab_name_template": "%b %Y",
    "date_format": "%d/%m/%Y",
    "skip_existing_by": "number",
    "raw_sheet_suffix": " [Auto]",
    "protect_raw_sheets": true
  }
}